# Copy this file to .env and fill in your local MySQL credentials.
# Never commit .env to GitHub.

PORT=4173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=appointment_reminder_system

# Optional: the single workspace owner used by the app.
DEFAULT_USER_ID=usr_default
DEFAULT_USER_NAME=Tempo User
DEFAULT_USER_EMAIL=owner@tempo.local
